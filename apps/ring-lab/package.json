    "catalogue": "node src/renderCatalogue.mjs"
  },
  "dependencies": {
    "meshoptimizer": "1.3.0",
    "rhino3dm": "8.35.0",
    "three": "0.170.0",
    "three-gpu-pathtracer": "0.0.23",
    "three-mesh-bvh": "0.9.17"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
