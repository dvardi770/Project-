DATABASE_URL=postgresql://user:password@localhost:5432/jewelry
# Public address of this dashboard; billing providers redirect back to it.
DASHBOARD_URL=https://dashboard.example.com
# At least 32 random characters: signs the login cookie.
SESSION_SECRET=
# Same key as the API: reads the store's Shopify credentials for Shopify billing.
CREDENTIALS_ENCRYPTION_KEY=

# The plan every merchant subscribes to.
BILLING_PLAN_NAME=Jewelry Builder
BILLING_PRICE_USD=99.00

# Stripe (WooCommerce, Wix and custom stores). The price is a recurring monthly Price in your Stripe account.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Shopify (Shopify stores). The app's client secret verifies billing webhooks.
SHOPIFY_APP_SECRET=
# true creates test charges that never bill; required on development stores.
SHOPIFY_BILLING_TEST=false

# Casting vendor that "Fulfill Casting via Platform Foundry" routes orders to.
PLATFORM_FOUNDRY_NAME=Platform Foundry
