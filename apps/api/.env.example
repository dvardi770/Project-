DATABASE_URL=postgresql://user:password@localhost:5432/jewelry
# Optional. Without it the API caches in process memory (single instance only).
REDIS_URL=redis://localhost:6379
# At least 32 random characters, e.g. `openssl rand -hex 32`.
BUNDLE_SIGNING_SECRET=
# Feeds every tenant may search through the platform's own account.
PLATFORM_FEEDS=NIVODA
# Extra browser origins allowed during development, comma separated.
CORS_DEV_ORIGINS=http://localhost:3000
PORT=4000
# 32-byte key (64 hex chars) for storefront credentials stored in the database,
# e.g. `openssl rand -hex 32`. Required for checkout and order webhooks.
CREDENTIALS_ENCRYPTION_KEY=
RATE_LIMIT_PER_MINUTE=240
CHECKOUT_RATE_LIMIT_PER_MINUTE=30
# Client secret of your Shopify app: verifies App Proxy requests. Optional if
# every store's secret is stored with set-credentials instead.
SHOPIFY_APP_SECRET=
# Public URL of the widget script if you host it on a CDN. By default the API
# serves apps/widget/dist/jewelry-configurator.js at /widget/jewelry-configurator.js.
# WIDGET_SCRIPT_URL=https://cdn.example.com/jewelry-configurator.js
# WIDGET_BUNDLE_PATH=/srv/widget/jewelry-configurator.js
# Rendered photos, 360° videos and the live 3D viewer (apps/ring-lab), one folder per collection.
# Settings point at them with renderKey "<collection>/<combo>". Served at /renders/ unless
# RENDERS_PUBLIC_URL says where the same folder is on a CDN.
# RENDERS_DIR=/srv/renders
# RENDERS_PUBLIC_URL=https://cdn.example.com/renders

# Practice mode (docs/practice-wordpress.md): set on a practice server with a database of its own.
# The site the practice store is for; at start-up the store is created if missing.
# PRACTICE_SITE=https://my-shop.com
# WooCommerce connection for the practice store (needs CREDENTIALS_ENCRYPTION_KEY).
# PRACTICE_WOO_KEY=
# PRACTICE_WOO_SECRET=
# PRACTICE_WOO_PRODUCT_ID=
# PRACTICE_WEBHOOK_SECRET=
