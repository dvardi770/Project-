DATABASE_URL=postgresql://user:password@localhost:5432/jewelry
# Same Redis as the API, so a finished feed sync drops the API's cached searches.
REDIS_URL=redis://localhost:6379
# Same key as the API; needed to remove one-off cart products from stores.
CREDENTIALS_ENCRYPTION_KEY=

# Nivoda account. Leave empty to run without the feed sync.
NIVODA_USERNAME=
NIVODA_PASSWORD=
# NIVODA_ENDPOINT=https://integrations.nivoda.net/api/diamonds
# cents (default) or dollars: the unit of `price` in your Nivoda account's responses
NIVODA_PRICE_UNIT=cents

FEED_SYNC_INTERVAL_MINUTES=360
CLEANUP_INTERVAL_MINUTES=60
