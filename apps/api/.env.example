DATABASE_URL=postgresql://user:password@localhost:5432/jewelry
# Optional. Without it the API caches in process memory (single instance only).
REDIS_URL=redis://localhost:6379
# At least 32 random characters, e.g. `openssl rand -hex 32`.
BUNDLE_SIGNING_SECRET=
# Feeds every tenant may search through the platform's own account.
PLATFORM_FEEDS=NIVODA
# Extra browser origins allowed during development, comma separated.
CORS_DEV_ORIGINS=http://localhost:3000
PORT=4000
# 32-byte key (64 hex chars) for storefront credentials stored in the database,
# e.g. `openssl rand -hex 32`. Required for checkout and order webhooks.
CREDENTIALS_ENCRYPTION_KEY=
RATE_LIMIT_PER_MINUTE=240
CHECKOUT_RATE_LIMIT_PER_MINUTE=30
