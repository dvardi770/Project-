{
  "name": "@jewelry/ring-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "3D ring lab: a parametric ring and wedding band builder with ray-traced stones, a configurator built from Rhino/MatrixGold files with an automatic fit check, and a render studio.",
  "scripts": {
    "convert": "node src/convert.mjs",
    "fit-check": "node src/fitCheck.mjs",
    "catalogue": "node src/renderCatalogue.mjs",
    "test:e2e": "node test/configurator.e2e.mjs"
  },
  "dependencies": {
    "meshoptimizer": "1.3.0",
    "rhino3dm": "8.35.0",
    "three": "0.170.0",
    "three-gpu-pathtracer": "0.0.23",
    "three-mesh-bvh": "0.9.17"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
